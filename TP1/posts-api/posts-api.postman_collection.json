      "name": "1. Lire",
      "description": "GET /posts, GET /posts/:id et le filtre ?postId=",
      "item": [
        {
          "name": "Liste des posts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 200', () => pm.response.to.have.status(200))",
                  "",
                  "pm.test('Un tableau de posts avec leurs cinq champs', () => {",
                  "  const posts = pm.response.json()",
                  "  pm.expect(posts).to.be.an('array').that.is.not.empty",
                  "  posts.forEach((post) => pm.expect(post).to.have.all.keys('postId', 'id', 'name', 'email', 'body'))",
                  "})"
