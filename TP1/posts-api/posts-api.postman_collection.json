    {
      "name": "3. Remplacer et modifier",
      "description": "PUT et PATCH sur le post créé (variable createdId)",
      "item": [
        {
          "name": "Remplacer le post (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts/{{createdId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "{{createdId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"postId\": 2,\n  \"name\": \"Post remplacé\",\n  \"email\": \"grace@exemple.com\",\n  \"body\": \"Nouveau contenu.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 200', () => pm.response.to.have.status(200))",
                  "",
                  "pm.test('Tous les champs remplacés, id inchangé', () => {",
                  "  const post = pm.response.json()",
                  "  pm.expect(post.id).to.eql(Number(pm.collectionVariables.get('createdId')))",
                  "  pm.expect(post.name).to.eql('Post remplacé')",
                  "  pm.expect(post.postId).to.eql(2)",
                  "})"
                ]
              }
            }
