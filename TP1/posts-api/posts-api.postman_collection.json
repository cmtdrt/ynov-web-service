  "info": {
    "name": "TP1 - posts-api",
    "description": "Requêtes pour tester l'API posts-api. Lancer le serveur (npm start), puis exécuter la collection dans l'ordre (Run collection) : la requête « Créer un post » enregistre l'id créé dans la variable createdId, réutilisée par PUT, PATCH et DELETE. Redémarrer le serveur pour revenir aux dix posts de départ.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "createdId",
      "value": ""
    }
  ],
