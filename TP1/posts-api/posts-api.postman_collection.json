    {
      "name": "2. Créer",
      "description": "POST /posts : création, en-tête Location et validation",
      "item": [
        {
          "name": "Créer un post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"postId\": 1,\n  \"name\": \"Mon premier post\",\n  \"email\": \"ada@exemple.com\",\n  \"body\": \"Le contenu de mon post.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 201', () => pm.response.to.have.status(201))",
                  "",
                  "pm.test('Le post créé avec un id entier', () => {",
                  "  const post = pm.response.json()",
                  "  pm.expect(Number.isInteger(post.id)).to.be.true",
                  "  pm.expect(post.name).to.eql('Mon premier post')",
                  "  pm.collectionVariables.set('createdId', post.id)",
                  "})",
                  "",
                  "pm.test('En-tête Location = /posts/<id>', () => {",
                  "  pm.expect(pm.response.headers.get('Location')).to.eql('/posts/' + pm.response.json().id)",
                  "})"
                ]
              }
            }
          ]
        },
